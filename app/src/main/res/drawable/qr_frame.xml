<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Transparent background -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <stroke
                android:width="4dp"
                android:color="@color/colorPrimary" />
            <size
                android:width="300dp"
                android:height="300dp" />
            <corners android:radius="8dp" />
        </shape>
    </item>

    <!-- Corner marks -->
    <item android:top="0dp" android:left="0dp">
        <rotate android:fromDegrees="0">
            <shape android:shape="line">
                <stroke
                    android:width="8dp"
                    android:color="@color/colorPrimary" />
                <size
                    android:width="40dp"
                    android:height="40dp" />
            </shape>
        </rotate>
    </item>
    <item android:top="0dp" android:right="0dp">
        <rotate android:fromDegrees="90">
            <shape android:shape="line">
                <stroke
                    android:width="8dp"
                    android:color="@color/colorPrimary" />
                <size
                    android:width="40dp"
                    android:height="40dp" />
            </shape>
        </rotate>
    </item>
    <item android:bottom="0dp" android:right="0dp">
        <rotate android:fromDegrees="180">
            <shape android:shape="line">
                <stroke
                    android:width="8dp"
                    android:color="@color/colorPrimary" />
                <size
                    android:width="40dp"
                    android:height="40dp" />
            </shape>
        </rotate>
    </item>
    <item android:bottom="0dp" android:left="0dp">
        <rotate android:fromDegrees="270">
            <shape android:shape="line">
                <stroke
                    android:width="8dp"
                    android:color="@color/colorPrimary" />
                <size
                    android:width="40dp"
                    android:height="40dp" />
            </shape>
        </rotate>
    </item>
</layer-list>