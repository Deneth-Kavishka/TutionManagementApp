<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/attendanceLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    android:orientation="vertical"
    android:background="#F8FAFF">

    <!-- Title -->
    <TextView
        android:id="@+id/tvAttendanceTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Student Attendance"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="#000000"
        android:layout_marginBottom="16dp" />

    <!-- Scan QR Button -->
    <Button
        android:id="@+id/btnScanQr"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Scan QR Code"
        android:drawableStart="@drawable/ic_qr_code"
        android:drawablePadding="8dp"
        android:padding="12dp"
        android:backgroundTint="#1976D2"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:layout_marginBottom="24dp" />

    <!-- Attendance List Header -->
    <TextView
        android:text="Recent Attendance"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="#444444"
        android:layout_marginBottom="8dp" />

    <!-- RecyclerView for Attendance -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerAttendance"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scrollbars="vertical" />

</LinearLayout>
