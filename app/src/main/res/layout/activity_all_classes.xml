<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="40px"
        android:background="#471396"
        android:padding="26px"
        android:text="All classes"
        android:textAlignment="center"
        android:textColor="@color/white"
        android:textSize="20dp"
        android:layout_marginBottom="4dp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="68dp"
        android:layout_marginHorizontal="20dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <!-- Search bar -->
        <androidx.appcompat.widget.SearchView
            android:id="@+id/idSV"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_marginTop="6px"
            android:layout_weight="2"
            android:background="@drawable/rounded_search_background"
            android:iconifiedByDefault="false"
            android:paddingHorizontal="12dp"
            android:paddingVertical="8dp"
            android:queryBackground="@android:color/transparent"
            android:queryHint="Search by class name" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/searchBtn"
            android:layout_width="309dp"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:layout_marginHorizontal="4dp"
            android:layout_weight="1"
            android:backgroundTint="#1187FF"
            android:text="Search"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            android:textSize="12sp"
            app:cornerRadius="6dp"
            app:elevation="2dp" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/classesContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:orientation="vertical"
            android:layout_marginTop="0dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/border_container"
            android:padding="16dp">

            <!-- Sample Class Card - You can duplicate this or populate programmatically -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="8dp"
                app:cardBackgroundColor="@android:color/white"
                app:cardCornerRadius="12dp"
                app:cardElevation="8dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="5dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Class name: Chemistry"
                            android:textSize="16dp"
                            android:textColor="#333"
                            android:textStyle="bold"/>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Time: 8:00 - 12:00"
                            android:textSize="12dp"
                            android:textColor="#333"
                            android:textStyle="bold"/>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Day: SunDay"
                            android:textSize="12dp"
                            android:textColor="#333"
                            android:textStyle="bold"/>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Hall: 1"
                            android:textSize="12dp"
                            android:textColor="#333"
                            android:textStyle="bold"/>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="8dp"
                        android:gravity="center">

                        <!-- Delete Button -->
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/deleteClassBtn"
                            android:layout_width="0dp"
                            android:layout_height="36dp"
                            android:layout_weight="1"
                            android:layout_marginHorizontal="4dp"
                            android:backgroundTint="#E53935"
                            app:cornerRadius="6dp"
                            android:text="Delete"
                            android:textColor="@android:color/white"
                            android:textSize="12sp"
                            android:textAllCaps="false"
                            app:elevation="2dp" />

                        <!-- View Button -->
                        <com.google.android.material.button.MaterialButton
                            android:layout_width="0dp"
                            android:layout_height="36dp"
                            android:layout_weight="1"
                            android:layout_marginStart="4dp"
                            android:backgroundTint="#04BA38"
                            app:cornerRadius="6dp"
                            android:id="@+id/viewClassBtn"
                            android:text="View"
                            android:textColor="@android:color/white"
                            android:textSize="12sp"
                            android:textAllCaps="false"
                            app:elevation="2dp" />

                        <!-- Update Button -->
                        <com.google.android.material.button.MaterialButton
                            android:layout_width="0dp"
                            android:layout_height="36dp"
                            android:layout_weight="1"
                            android:layout_marginStart="4dp"
                            android:backgroundTint="#03A9F4"
                            app:cornerRadius="6dp"
                            android:text="Update"
                            android:id="@+id/updateBottomSheetBtn"
                            android:textColor="@android:color/white"
                            android:textSize="12sp"
                            android:textAllCaps="false"
                            app:elevation="2dp" />
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </ScrollView>
</LinearLayout>