<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    app:cardCornerRadius="8dp"
    app:cardElevation="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp">

        <ImageView
            android:id="@+id/ivTeacherPhoto"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginEnd="12dp"
            android:background="@drawable/circle_background"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_person_placeholder" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvTeacherName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Dr. Jane Smith"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/text_color_primary" />

            <TextView
                android:id="@+id/tvTeacherId"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="ID: TCH001"
                android:textSize="12sp"
                android:textColor="@color/text_color_secondary"
                android:layout_marginTop="2dp" />

            <TextView
                android:id="@+id/tvSubjects"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Mathematics, Physics"
                android:textSize="12sp"
                android:textColor="@color/text_color_secondary"
                android:layout_marginTop="2dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="4dp">

                <TextView
                    android:id="@+id/tvJoiningDate"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Joined: 2024-01-01"
                    android:textSize="11sp"
                    android:textColor="@color/text_color_secondary" />

                <TextView
                    android:id="@+id/tvEmploymentType"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Full-time"
                    android:textSize="12sp"
                    android:textColor="@color/success_color"
                    android:background="@drawable/badge_background"
                    android:padding="4dp" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>
