<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:card_view="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FAFAFA">

    <!-- Scrollable Content -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="20dp">

        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- 🔵 Profile Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="20dp">

                <ImageView
                    android:id="@+id/profileImage"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:src="@drawable/user_ic"
                    android:scaleType="centerCrop"
                    android:layout_marginEnd="12dp"
                    android:contentDescription="Profile Picture" />

                <TextView
                    android:id="@+id/tvParentName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Parent.."
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="#212121" />
            </LinearLayout>

            <!-- 📘 Section Title -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Subject-wise Results"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="#212121"
                android:layout_marginBottom="24dp" />

            <!-- ✅ Math Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                card_view:cardCornerRadius="8dp"
                card_view:cardElevation="4dp"
                android:layout_marginBottom="16dp"
                android:padding="12dp">

                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        android:text="Math"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="#1E88E5"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#CCCCCC"
                        android:layout_marginTop="8dp"
                        android:layout_marginBottom="8dp" />

                    <LinearLayout
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <TextView
                            android:id="@+id/tvMathMarks"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:text="85%"
                            android:textStyle="bold"
                            android:textSize="16sp"
                            android:textColor="#212121" />

                        <View
                            android:layout_width="1dp"
                            android:layout_height="match_parent"
                            android:background="#CCCCCC"
                            android:layout_marginHorizontal="8dp" />

                        <TextView
                            android:id="@+id/tvMathStatus"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:text="↑ Increased"
                            android:textStyle="bold"
                            android:textSize="16sp"
                            android:textColor="#2E7D32" />
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- ✅ Science Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                card_view:cardCornerRadius="8dp"
                card_view:cardElevation="4dp"
                android:layout_marginBottom="16dp"
                android:padding="12dp">

                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        android:text="Science"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="#1E88E5"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#CCCCCC"
                        android:layout_marginTop="8dp"
                        android:layout_marginBottom="8dp" />

                    <LinearLayout
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <TextView
                            android:id="@+id/tvScienceMarks"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:text="55%"
                            android:textStyle="bold"
                            android:textSize="16sp"
                            android:textColor="#212121" />

                        <View
                            android:layout_width="1dp"
                            android:layout_height="match_parent"
                            android:background="#CCCCCC"
                            android:layout_marginHorizontal="8dp" />

                        <TextView
                            android:id="@+id/tvScienceStatus"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:text="↓ Decreased"
                            android:textStyle="bold"
                            android:textSize="16sp"
                            android:textColor="#C62828" />
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- ✅ English Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                card_view:cardCornerRadius="8dp"
                card_view:cardElevation="4dp"
                android:layout_marginBottom="16dp"
                android:padding="12dp">

                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        android:text="English"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="#1E88E5"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#CCCCCC"
                        android:layout_marginTop="8dp"
                        android:layout_marginBottom="8dp" />

                    <LinearLayout
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <TextView
                            android:id="@+id/tvEnglishMarks"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:text="70%"
                            android:textStyle="bold"
                            android:textSize="16sp"
                            android:textColor="#212121" />

                        <View
                            android:layout_width="1dp"
                            android:layout_height="match_parent"
                            android:background="#CCCCCC"
                            android:layout_marginHorizontal="8dp" />

                        <TextView
                            android:id="@+id/tvEnglishStatus"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:text="→ No Change"
                            android:textStyle="bold"
                            android:textSize="16sp"
                            android:textColor="#616161" />
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </LinearLayout>
    </ScrollView>

    <!-- 🔻 Bottom Navigation Bar -->
    <LinearLayout
        android:id="@+id/bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="#1565C0"
        android:elevation="6dp">

        <ImageView
            android:id="@+id/nav_home"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:src="@drawable/home_ic"
            android:contentDescription="Home"
            android:padding="12dp" />


        <ImageView
            android:id="@+id/nav_result"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:src="@drawable/result_ic"
            android:background="#C62828"
            android:contentDescription="Result"
            android:padding="12dp" />

        <ImageView
            android:id="@+id/nav_fees"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:src="@drawable/payement_ic"
            android:contentDescription="Fees"
            android:padding="12dp" />

        <ImageView
            android:id="@+id/nav_logout"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:src="@drawable/logout_ic"
            android:contentDescription="Logout"
            android:padding="12dp" />
    </LinearLayout>

</LinearLayout>
