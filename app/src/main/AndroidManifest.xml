<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">


    <!-- Permissions -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="28" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />

    <!-- Declare camera hardware feature as optional -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />


    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-feature android:name="android.hardware.camera.autofocus"
        android:required="false" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <uses-feature
        android:name="android.hardware.telephony"
        android:required="false" />


    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.TuitionManagementApp"
        tools:targetApi="31">


        <!-- Launch Dashboard first -->
        <activity
            android:name=".student.StudentDashboardActivity"


        <activity
            android:name=".teacher.TeacherDashboardActivity"

            android:name=".admin.AdminDashboardActivity"
            android:exported="true"
            android:screenOrientation="portrait">

            android:name=".ParentPortalActivity"

            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>


        <!-- Other Activities -->


        <activity android:name=".student.AttendanceActivity" />
        <activity android:name=".student.AssignmentActivity" />
        <activity android:name=".student.ResultActivity" />
        <activity android:name=".student.MaterialActivity" />
        <activity android:name=".student.ProfileActivity" />

    </application>
</manifest>

        <activity android:name=".teacher.EditProfileActivity" />
        <activity android:name=".teacher.AssignmentActivity" />
        <activity android:name=".teacher.MaterialsActivity" />
        <activity android:name=".teacher.AttendanceActivity" />
        <activity android:name=".teacher.UploadResultActivity" />

        <activity
            android:name=".teacher.CaptureActivityPortrait"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.AppCompat.Light.NoActionBar" />






    </application>


        <!-- Add this for QR Scanner -->
        <activity
            android:name=".admin.QRScannerActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

    </application>
</manifest>

